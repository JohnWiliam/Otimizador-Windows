<Window
    x:Class="SystemOptimizer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:SystemOptimizer.Helpers">

    <Grid>
        <Grid.Resources>
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </Grid.Resources>
        <NavigationView x:Name="RootNavigation"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        IsPaneOpen="True"
                        OpenPaneLength="240"
                        SelectionChanged="RootNavigation_SelectionChanged">
            <NavigationView.Header>
                <TextBlock Text="Otimizador de Sistema" FontSize="20" FontWeight="SemiBold" Margin="8,0,0,0" />
            </NavigationView.Header>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Privacidade" Tag="Privacy" Icon="ProtectedDocument" />
                <NavigationViewItem Content="Desempenho" Tag="Performance" Icon="SpeedHigh" />
                <NavigationViewItem Content="Rede" Tag="Network" Icon="Globe" />
                <NavigationViewItem Content="Segurança" Tag="Security" Icon="Permissions" />
                <NavigationViewItem Content="Pesquisa" Tag="Search" Icon="Find" />
                <NavigationViewItem Content="Visual" Tag="Appearance" Icon="Edit" />
                <NavigationViewItem Content="Tweaks" Tag="Tweaks" Icon="Repair" />
                <NavigationViewItem Content="Limpeza" Tag="Cleanup" Icon="Delete" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Configurações" Tag="Settings" Icon="Setting" />
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <Grid Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
              Visibility="{Binding IsInitializing, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsIndeterminate="True" Width="52" Height="52" />
                <TextBlock Text="Carregando recursos e estados do sistema..." FontSize="16" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
