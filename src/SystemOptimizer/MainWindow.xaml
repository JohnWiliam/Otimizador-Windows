<Window
    x:Class="SystemOptimizer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="Otimizador Windows">

    <Grid>
        <controls:NavigationView x:Name="RootNavigation"
                                 PaneDisplayMode="Left"
                                 IsBackButtonVisible="Collapsed"
                                 IsSettingsVisible="False"
                                 OpenPaneLength="240"
                                 SelectionChanged="RootNavigation_SelectionChanged">
            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem Content="Privacidade" Tag="privacy" Icon="ProtectedDocument" />
                <controls:NavigationViewItem Content="Performance" Tag="performance" Icon="SpeedHigh" />
                <controls:NavigationViewItem Content="Rede" Tag="network" Icon="Globe" />
                <controls:NavigationViewItem Content="Segurança" Tag="security" Icon="Permissions" />
                <controls:NavigationViewItem Content="Pesquisa" Tag="search" Icon="Find" />
                <controls:NavigationViewItem Content="Visual" Tag="appearance" Icon="Color" />
                <controls:NavigationViewItem Content="Tweaks" Tag="tweaks" Icon="Repair" />
                <controls:NavigationViewItem Content="Limpeza" Tag="cleanup" Icon="Delete" />
            </controls:NavigationView.MenuItems>
            <controls:NavigationView.FooterMenuItems>
                <controls:NavigationViewItem Content="Configurações" Tag="settings" Icon="Setting" />
            </controls:NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" />
        </controls:NavigationView>

        <Grid x:Name="InitializingOverlay"
              Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <controls:ProgressRing IsIndeterminate="True" Width="48" Height="48" />
                <TextBlock Text="Carregando estado do sistema..."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
