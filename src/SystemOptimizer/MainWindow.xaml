<Window
    x:Class="SystemOptimizer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="System Optimizer">

    <Grid>
        <NavigationView x:Name="RootNavigation"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        PaneDisplayMode="LeftCompact"
                        SelectionChanged="RootNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Privacidade" Icon="ContactInfo" Tag="Privacy" />
                <NavigationViewItem Content="Performance" Icon="SpeedHigh" Tag="Performance" />
                <NavigationViewItem Content="Rede" Icon="Globe" Tag="Network" />
                <NavigationViewItem Content="Segurança" Icon="Permissions" Tag="Security" />
                <NavigationViewItem Content="Pesquisa" Icon="Find" Tag="Search" />
                <NavigationViewItem Content="Limpeza" Icon="Delete" Tag="Cleanup" />
                <NavigationViewItem Content="Visual" Icon="Palette" Tag="Appearance" />
                <NavigationViewItem Content="Tweaks" Icon="Repair" Tag="Tweaks" />
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <Grid x:Name="LoadingOverlay"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="54" Height="54" />
                <TextBlock Text="Carregando otimizações..." Style="{ThemeResource BodyStrongTextBlockStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
