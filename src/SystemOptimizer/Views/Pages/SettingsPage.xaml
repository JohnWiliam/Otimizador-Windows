<Page x:Name="RootPage"
    x:Class="SystemOptimizer.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="28">
        <StackPanel Spacing="18">
            <TextBlock Text="Configurações" Style="{StaticResource TitleTextBlockStyle}" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Idioma" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Altera a cultura da interface. Reinicie para aplicar todos os textos." Opacity="0.72" TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding CurrentLanguage, Mode=TwoWay}" />
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Tema" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Usa tema do sistema, claro ou escuro com superfície Fluent 2 e Mica." Opacity="0.72" TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding CurrentThemeOption, Mode=TwoWay}" DisplayMemberPath="Name" />
            </Grid>

            <ToggleSwitch Header="Persistência segura no logon" IsOn="{Binding IsPersistenceEnabled, Mode=TwoWay}" />
            <ToggleSwitch Header="Manter atalho instalado" IsOn="{Binding IsKeepInstalledEnabled, Mode=TwoWay}" />

            <Button Command="{Binding CheckForUpdatesCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Download" />
                    <TextBlock Text="Verificar atualização" />
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</Page>
