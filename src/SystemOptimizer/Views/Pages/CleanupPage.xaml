<Page x:Class="SystemOptimizer.Views.Pages.CleanupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:p="clr-namespace:SystemOptimizer.Properties"
      mc:Ignorable="d"
      d:DesignHeight="760" d:DesignWidth="980"
      x:Name="RootPage"
      Title="CleanupPage"
      FontFamily="Segoe UI">

    <Page.Resources>
        <CubicEase x:Key="SoftEaseOut" EasingMode="EaseOut"/>
        <QuinticEase x:Key="FluidEaseOut" EasingMode="EaseOut"/>

        <Style x:Key="EntranceCardStyle" TargetType="ui:Card">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="18"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             To="1"
                                             Duration="0:0:0.42"
                                             EasingFunction="{StaticResource SoftEaseOut}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             To="0"
                                             Duration="0:0:0.52"
                                             EasingFunction="{StaticResource FluidEaseOut}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CleanupTileCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.015" Duration="0:0:0.18"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.015" Duration="0:0:0.18"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.22"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.22"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:Card Grid.Row="0"
                     Style="{StaticResource EntranceCardStyle}"
                     Padding="0"
                     Margin="0,0,0,18">
                <Border CornerRadius="8" Padding="24">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#163B64" Offset="0"/>
                            <GradientStop Color="#0B6F73" Offset="0.55"/>
                            <GradientStop Color="#232257" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Static p:Resources.Cleanup_Title}"
                                       Foreground="White"
                                       FontSize="30"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{x:Static p:Resources.Cleanup_CacheDesc}"
                                       Foreground="#DDEBFF"
                                       FontSize="14"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       MaxWidth="620" />

                            <WrapPanel Margin="0,20,0,0">
                                <ui:Button Command="{Binding AnalyzeCommand, ElementName=RootPage}"
                                           IsEnabled="{Binding CanAnalyze, ElementName=RootPage}"
                                           Appearance="Primary"
                                           Height="40"
                                           Padding="18,0"
                                           Margin="0,0,10,8">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Search24" Margin="0,0,8,0"/>
                                        <TextBlock Text="{x:Static p:Resources.Cleanup_ActionAnalyze}"/>
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Command="{Binding CleanupSelectedCommand, ElementName=RootPage}"
                                           IsEnabled="{Binding CanCleanup, ElementName=RootPage}"
                                           Appearance="Secondary"
                                           Height="40"
                                           Padding="18,0"
                                           Margin="0,0,10,8">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Delete24" Margin="0,0,8,0"/>
                                        <TextBlock Text="{x:Static p:Resources.Cleanup_ActionClean}"/>
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Command="{Binding CancelCommand, ElementName=RootPage}"
                                           Visibility="{Binding CancelVisibility, ElementName=RootPage}"
                                           Appearance="Secondary"
                                           Height="40"
                                           Padding="18,0"
                                           Margin="0,0,10,8">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,8,0"/>
                                        <TextBlock Text="{x:Static p:Resources.Cleanup_ActionCancel}"/>
                                    </StackPanel>
                                </ui:Button>
                            </WrapPanel>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Width="132"
                                Height="132"
                                Margin="24,0,0,0"
                                CornerRadius="66"
                                Background="#25FFFFFF"
                                BorderBrush="#45FFFFFF"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Grid>
                                <Ellipse Stroke="#44FFFFFF" StrokeThickness="10" Margin="12"/>
                                <Ellipse Stroke="#9BFFDF5D" StrokeThickness="10" Margin="12"
                                         StrokeDashArray="2 3"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:8"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding CleanupProgressPercentage, ElementName=RootPage, StringFormat={}{0}%}"
                                               Foreground="White"
                                               FontSize="26"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="status"
                                               Foreground="#DDEBFF"
                                               FontSize="11"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </ui:Card>

            <ui:Card Grid.Row="1"
                     Style="{StaticResource EntranceCardStyle}"
                     Padding="20"
                     Margin="0,0,0,18">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="12" Background="#1633A6FF" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Broom24" FontSize="22" Foreground="#33A6FF"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static p:Resources.Cleanup_CacheTitle}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Selecione os módulos. A análise mede o potencial antes de qualquer remoção."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="{x:Static p:Resources.Cleanup_SelectOptions}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <UniformGrid Columns="2">
                        <CheckBox Style="{StaticResource CleanupTileCheckBoxStyle}" IsChecked="{Binding CleanTemp, ElementName=RootPage}">
                            <Border Padding="14" CornerRadius="10" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Document24" Foreground="#4FC3F7" FontSize="20" Margin="0,0,10,0"/>
                                    <TextBlock Text="{x:Static p:Resources.Cleanup_OptionTemp}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </CheckBox>
                        <CheckBox Style="{StaticResource CleanupTileCheckBoxStyle}" IsChecked="{Binding CleanSystemTemp, ElementName=RootPage}">
                            <Border Padding="14" CornerRadius="10" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="HardDrive24" Foreground="#64B5F6" FontSize="20" Margin="0,0,10,0"/>
                                    <TextBlock Text="{x:Static p:Resources.Cleanup_OptionSystemTemp}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </CheckBox>
                        <CheckBox Style="{StaticResource CleanupTileCheckBoxStyle}" IsChecked="{Binding CleanPrefetch, ElementName=RootPage}">
                            <Border Padding="14" CornerRadius="10" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Rocket24" Foreground="#FFB74D" FontSize="20" Margin="0,0,10,0"/>
                                    <TextBlock Text="{x:Static p:Resources.Cleanup_OptionPrefetch}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </CheckBox>
                        <CheckBox Style="{StaticResource CleanupTileCheckBoxStyle}" IsChecked="{Binding CleanWindowsUpdate, ElementName=RootPage}">
                            <Border Padding="14" CornerRadius="10" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowSync24" Foreground="#9575CD" FontSize="20" Margin="0,0,10,0"/>
                                    <TextBlock Text="{x:Static p:Resources.Cleanup_OptionWindowsUpdate}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </CheckBox>
                        <CheckBox Style="{StaticResource CleanupTileCheckBoxStyle}" IsChecked="{Binding CleanBrowser, ElementName=RootPage}">
                            <Border Padding="14" CornerRadius="10" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Globe24" Foreground="#FFD54F" FontSize="20" Margin="0,0,10,0"/>
                                    <TextBlock Text="{x:Static p:Resources.Cleanup_OptionBrowser}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </CheckBox>
                        <CheckBox Style="{StaticResource CleanupTileCheckBoxStyle}" IsChecked="{Binding CleanDns, ElementName=RootPage}">
                            <Border Padding="14" CornerRadius="10" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Wifi124" Foreground="#4DB6AC" FontSize="20" Margin="0,0,10,0"/>
                                    <TextBlock Text="{x:Static p:Resources.Cleanup_OptionDNS}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </CheckBox>
                        <CheckBox Style="{StaticResource CleanupTileCheckBoxStyle}" IsChecked="{Binding CleanRecycleBin, ElementName=RootPage}">
                            <Border Padding="14" CornerRadius="10" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Delete24" Foreground="#E57373" FontSize="20" Margin="0,0,10,0"/>
                                    <TextBlock Text="{x:Static p:Resources.Cleanup_OptionRecycleBin}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </CheckBox>
                    </UniformGrid>
                </StackPanel>
            </ui:Card>

            <ui:Card x:Name="SummaryCard"
                     Grid.Row="2"
                     Style="{StaticResource EntranceCardStyle}"
                     Padding="0"
                     Margin="0,0,0,18"
                     Visibility="{Binding ShouldShowSummaryCard, ElementName=RootPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Padding="18,14"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="8,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="DataHistogram20" Margin="0,0,10,0" FontSize="18"/>
                                <TextBlock Text="{x:Static p:Resources.Cleanup_ScanSummaryTitle}" FontWeight="SemiBold" FontSize="14" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedScanCountLabel, ElementName=RootPage}" Margin="0,0,16,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding SelectedScanSizeLabel, ElementName=RootPage}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="18">
                        <ProgressBar Minimum="0" Maximum="100" Height="8" Value="{Binding CleanupProgressPercentage, ElementName=RootPage}" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding ScanResults, ElementName=RootPage}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="12"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.28"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.34" EasingFunction="{StaticResource SoftEaseOut}"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ItemsLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding SizeLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,8,0,4" Text="{Binding CleanupProgressCategory, ElementName=RootPage}" FontWeight="SemiBold" />
                        <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding CleanupProcessedItemsLabel, ElementName=RootPage}"/>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <ui:Card x:Name="LogsCard"
                     Grid.Row="3"
                     Style="{StaticResource EntranceCardStyle}"
                     Padding="0"
                     MinHeight="280"
                     VerticalAlignment="Stretch"
                     VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="280"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="18,14"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="8,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="CodeText20" Margin="0,0,10,0" FontSize="18"/>
                                <TextBlock Text="{x:Static p:Resources.Cleanup_LogTitle}"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="14" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="checagem segura + execução auditável" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </Grid>
                    </Border>

                    <RichTextBox Grid.Row="1" x:Name="LogOutput"
                                 IsReadOnly="True"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="18"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 FontFamily="Segoe UI"
                                 FontSize="12">
                        <FlowDocument PagePadding="0" TextAlignment="Left" FontFamily="Segoe UI"/>
                    </RichTextBox>

                    <TextBlock Grid.Row="1"
                               IsHitTestVisible="False"
                               Text="{x:Static p:Resources.Cleanup_LogEmpty}"
                               Margin="18"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Top"
                               Visibility="{Binding HasLogs, ElementName=RootPage, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                </Grid>
            </ui:Card>
        </Grid>
    </ScrollViewer>
</Page>
