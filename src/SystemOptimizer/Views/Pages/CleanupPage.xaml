<Page x:Name="RootPage"
    x:Class="SystemOptimizer.Views.Pages.CleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SystemOptimizer.Models">

    <Grid Padding="28" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Limpeza confiável" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock Text="Selecione os alvos de limpeza. A análise é cancelável e executa fora da thread visual." Opacity="0.72" />
            <StackPanel Orientation="Vertical" Spacing="2">
                <CheckBox Content="Temp do usuário" IsChecked="{Binding CleanTemp, Mode=TwoWay}" />
                <CheckBox Content="Temp do sistema" IsChecked="{Binding CleanSystemTemp, Mode=TwoWay}" />
                <CheckBox Content="Prefetch" IsChecked="{Binding CleanPrefetch, Mode=TwoWay}" />
                <CheckBox Content="Windows Update" IsChecked="{Binding CleanWindowsUpdate, Mode=TwoWay}" />
                <CheckBox Content="Navegadores" IsChecked="{Binding CleanBrowser, Mode=TwoWay}" />
                <CheckBox Content="DNS" IsChecked="{Binding CleanDns, Mode=TwoWay}" />
                <CheckBox Content="Lixeira" IsChecked="{Binding CleanRecycleBin, Mode=TwoWay}" />
            </StackPanel>
        </StackPanel>

        <CommandBar Grid.Row="2" DefaultLabelPosition="Right" Background="Transparent">
            <AppBarButton Label="Analisar" Icon="Find" Command="{Binding AnalyzeCommand}" />
            <AppBarButton Label="Limpar selecionados" Icon="Delete" Command="{Binding CleanupSelectedCommand}" />
            <AppBarButton Label="Cancelar" Icon="Cancel" Command="{Binding CancelCommand}" />
        </CommandBar>

        <Grid Grid.Row="3" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <ListView ItemsSource="{Binding ScanResults}" Header="Resultados da análise">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="12" Spacing="4">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Summary}" Opacity="0.72" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ListView Grid.Column="1" ItemsSource="{Binding CleanupLogs}" Header="Registro de execução">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:CleanupLogItem">
                        <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" Padding="8" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
