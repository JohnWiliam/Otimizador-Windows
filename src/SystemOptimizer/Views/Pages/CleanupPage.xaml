<Page x:Class="SystemOptimizer.Views.Pages.CleanupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:p="clr-namespace:SystemOptimizer.Properties"
      mc:Ignorable="d"
      d:DesignHeight="760" d:DesignWidth="980"
      x:Name="RootPage"
      Title="CleanupPage"
      FontFamily="Segoe UI">

    <Page.Resources>
        <CubicEase x:Key="CleanupEaseOut" EasingMode="EaseOut" />

        <Style x:Key="CleanupActionButtonStyle" TargetType="ui:Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.025" Duration="0:0:0.22" EasingFunction="{StaticResource CleanupEaseOut}" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.025" Duration="0:0:0.22" EasingFunction="{StaticResource CleanupEaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="0:0:0.14" EasingFunction="{StaticResource CleanupEaseOut}" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.97" Duration="0:0:0.14" EasingFunction="{StaticResource CleanupEaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.025" Duration="0:0:0.16" EasingFunction="{StaticResource CleanupEaseOut}" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.025" Duration="0:0:0.16" EasingFunction="{StaticResource CleanupEaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.24" EasingFunction="{StaticResource CleanupEaseOut}" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.24" EasingFunction="{StaticResource CleanupEaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CleanupOptionTileStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="MinHeight" Value="66" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Tile"
                                Padding="14,12"
                                CornerRadius="14"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform Y="0" />
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="34" Height="34"
                                        CornerRadius="10"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        Margin="0,0,12,0">
                                    <ui:SymbolIcon Symbol="Broom24" FontSize="17" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                                <ContentPresenter Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                                <Border x:Name="CheckGlyph"
                                        Grid.Column="2"
                                        Width="24" Height="24"
                                        CornerRadius="12"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Background="Transparent"
                                        Margin="12,0,0,0">
                                    <ui:SymbolIcon x:Name="CheckIcon"
                                                   Symbol="Checkmark24"
                                                   FontSize="13"
                                                   Opacity="0"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="#4FC3F7" />
                                <Setter TargetName="Tile" Property="Background" Value="#1F4FC3F7" />
                                <Setter TargetName="CheckGlyph" Property="Background" Value="#4FC3F7" />
                                <Setter TargetName="CheckGlyph" Property="BorderBrush" Value="#4FC3F7" />
                                <Setter TargetName="CheckIcon" Property="Foreground" Value="White" />
                                <Setter TargetName="CheckIcon" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Tile" Property="Opacity" Value="0.58" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:Card x:Name="HeroCard" Grid.Row="0" Padding="0" Margin="0,0,0,16" RenderTransformOrigin="0.5,0.5">
            <ui:Card.RenderTransform>
                <TranslateTransform Y="0" />
            </ui:Card.RenderTransform>
            <Grid>
                <Border CornerRadius="18" Opacity="0.16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4FC3F7" Offset="0" />
                            <GradientStop Color="#9575CD" Offset="0.52" />
                            <GradientStop Color="#4DB6AC" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid Margin="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" MaxWidth="620">
                        <TextBlock Text="{x:Static p:Resources.Cleanup_Title}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   FontSize="30"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Análise visual, limpeza seletiva e execução protegida para remover apenas caches temporários configurados."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,18" />

                        <WrapPanel>
                            <ui:Button Command="{Binding AnalyzeCommand, ElementName=RootPage}"
                                       IsEnabled="{Binding CanAnalyze, ElementName=RootPage}"
                                       Appearance="Primary"
                                       Style="{StaticResource CleanupActionButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Search24" Margin="0,0,8,0" />
                                    <TextBlock Text="{x:Static p:Resources.Cleanup_ActionAnalyze}" />
                                </StackPanel>
                            </ui:Button>

                            <ui:Button Command="{Binding CleanupSelectedCommand, ElementName=RootPage}"
                                       IsEnabled="{Binding CanCleanup, ElementName=RootPage}"
                                       Appearance="Primary"
                                       Style="{StaticResource CleanupActionButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Delete24" Margin="0,0,8,0" />
                                    <TextBlock Text="{x:Static p:Resources.Cleanup_ActionClean}" />
                                </StackPanel>
                            </ui:Button>

                            <ui:Button Command="{Binding CancelCommand, ElementName=RootPage}"
                                       Visibility="{Binding CancelVisibility, ElementName=RootPage}"
                                       Appearance="Secondary"
                                       Style="{StaticResource CleanupActionButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,8,0" />
                                    <TextBlock Text="{x:Static p:Resources.Cleanup_ActionCancel}" />
                                </StackPanel>
                            </ui:Button>
                        </WrapPanel>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Width="190"
                            MinHeight="136"
                            CornerRadius="18"
                            Padding="18"
                            Margin="20,0,0,0"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Status" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding ActiveOperationTitle, ElementName=RootPage}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,10" />
                            <ProgressBar Height="7"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding CleanupProgressPercentage, ElementName=RootPage}" />
                            <TextBlock Text="{Binding CleanupProgressPercentage, ElementName=RootPage, StringFormat={}{0}%}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Right"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ui:Card>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" MinWidth="330" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.35*" MinWidth="420" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:Card x:Name="OptionsCard" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Padding="18" RenderTransformOrigin="0.5,0.5">
                <ui:Card.RenderTransform>
                    <TranslateTransform Y="0" />
                </ui:Card.RenderTransform>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="42" Height="42" CornerRadius="14" Background="#1F4FC3F7" Margin="0,0,12,0">
                                <ui:SymbolIcon Symbol="Broom24" FontSize="22" Foreground="#4FC3F7" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Static p:Resources.Cleanup_CacheTitle}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Static p:Resources.Cleanup_SelectOptions}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{x:Static p:Resources.Cleanup_CacheDesc}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16" />

                        <CheckBox Style="{StaticResource CleanupOptionTileStyle}" IsChecked="{Binding CleanTemp, ElementName=RootPage}">
                            <StackPanel>
                                <TextBlock Text="{x:Static p:Resources.Cleanup_OptionTemp}" FontWeight="SemiBold" />
                                <TextBlock Text="Arquivos temporários do usuário" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource CleanupOptionTileStyle}" IsChecked="{Binding CleanSystemTemp, ElementName=RootPage}">
                            <StackPanel>
                                <TextBlock Text="{x:Static p:Resources.Cleanup_OptionSystemTemp}" FontWeight="SemiBold" />
                                <TextBlock Text="Temporários do Windows e serviços" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource CleanupOptionTileStyle}" IsChecked="{Binding CleanPrefetch, ElementName=RootPage}">
                            <StackPanel>
                                <TextBlock Text="{x:Static p:Resources.Cleanup_OptionPrefetch}" FontWeight="SemiBold" />
                                <TextBlock Text="Entradas recriadas automaticamente pelo sistema" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource CleanupOptionTileStyle}" IsChecked="{Binding CleanWindowsUpdate, ElementName=RootPage}">
                            <StackPanel>
                                <TextBlock Text="{x:Static p:Resources.Cleanup_OptionWindowsUpdate}" FontWeight="SemiBold" />
                                <TextBlock Text="Cache de download com parada controlada de serviços" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource CleanupOptionTileStyle}" IsChecked="{Binding CleanBrowser, ElementName=RootPage}">
                            <StackPanel>
                                <TextBlock Text="{x:Static p:Resources.Cleanup_OptionBrowser}" FontWeight="SemiBold" />
                                <TextBlock Text="Caches de navegadores quando não estão em uso" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource CleanupOptionTileStyle}" IsChecked="{Binding CleanDns, ElementName=RootPage}">
                            <StackPanel>
                                <TextBlock Text="{x:Static p:Resources.Cleanup_OptionDNS}" FontWeight="SemiBold" />
                                <TextBlock Text="Renovação segura da resolução de rede" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource CleanupOptionTileStyle}" IsChecked="{Binding CleanRecycleBin, ElementName=RootPage}">
                            <StackPanel>
                                <TextBlock Text="{x:Static p:Resources.Cleanup_OptionRecycleBin}" FontWeight="SemiBold" />
                                <TextBlock Text="Ação opcional e destrutiva, desativada por padrão" Foreground="#D46A6A" FontSize="11" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </ScrollViewer>
            </ui:Card>

            <ui:Card x:Name="SummaryCard" Grid.Row="0" Grid.Column="2" Padding="18" Margin="0,0,0,16" RenderTransformOrigin="0.5,0.5">
                <ui:Card.RenderTransform>
                    <TranslateTransform Y="0" />
                </ui:Card.RenderTransform>
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Static p:Resources.Cleanup_ScanSummaryTitle}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedScanSummary, ElementName=RootPage}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Padding="12,7" CornerRadius="12" Background="{DynamicResource ControlFillColorSecondaryBrush}" Margin="0,0,8,0">
                                <TextBlock Text="{Binding TotalScanItemsLabel, ElementName=RootPage}" FontWeight="SemiBold" />
                            </Border>
                            <Border Padding="12,7" CornerRadius="12" Background="#1F4DB6AC">
                                <TextBlock Text="{Binding TotalScanSizeLabel, ElementName=RootPage}" Foreground="#4DB6AC" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{x:Static p:Resources.Cleanup_ScanSummaryEmpty}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,2,0,8"
                               Visibility="{Binding HasScanResults, ElementName=RootPage, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                    <ItemsControl ItemsSource="{Binding ScanResults, ElementName=RootPage}"
                                  Visibility="{Binding HasScanResults, ElementName=RootPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Opacity" Value="0" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="14" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.34" EasingFunction="{StaticResource CleanupEaseOut}" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.34" EasingFunction="{StaticResource CleanupEaseOut}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="14" CornerRadius="14" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ItemsLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeLabel}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="0,6,0,0" Padding="12" CornerRadius="12" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <StackPanel>
                            <TextBlock Text="{Binding CleanupProgressCategory, ElementName=RootPage}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CleanupProcessedItemsLabel, ElementName=RootPage}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:Card>

            <ui:Card x:Name="LogsCard" Grid.Row="1" Grid.Column="2" Padding="0" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <ui:Card.RenderTransform>
                    <TranslateTransform Y="0" />
                </ui:Card.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,12" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" CornerRadius="18,18,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="CodeText20" Margin="0,0,10,0" FontSize="16" />
                                <TextBlock Text="{x:Static p:Resources.Cleanup_LogTitle}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="pipeline seguro" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </Grid>
                    </Border>

                    <RichTextBox Grid.Row="1" x:Name="LogOutput"
                                 IsReadOnly="True"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="16"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 FontFamily="Segoe UI"
                                 FontSize="12">
                        <FlowDocument PagePadding="0" TextAlignment="Left" FontFamily="Segoe UI" />
                    </RichTextBox>

                    <TextBlock Grid.Row="1"
                               IsHitTestVisible="False"
                               Text="{x:Static p:Resources.Cleanup_LogEmpty}"
                               Margin="16"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Top"
                               Visibility="{Binding HasLogs, ElementName=RootPage, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
